---
const rows = [
  [80, 40, 180, 440, 180, 40],
  [4, 14, 8, 0, 8, 14],
  [52, 26, 117, 286, 117, 26],
  [24, 12, 54, 132, 54, 12],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eschaton Science</title>
    <style>
      @font-face {
        font-family: "Matrix Serif";
        src: url("/fonts/KaTeX_Main-Regular.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      :root {
        color-scheme: dark;
        background: #000;
        color: #fff;
        font-family: "Matrix Serif", "Cambria Math", serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        overflow: hidden;
      }

      main {
        visibility: hidden;
        position: relative;
        width: 100%;
        height: 100svh;
        isolation: isolate;
        overflow: hidden;
        background: #000;
      }

      main.scene-ready {
        visibility: visible;
      }

      #alignment {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        z-index: 0;
      }

      .matrix-frame {
        position: absolute;
        top: 29%;
        left: 50%;
        width: min(34rem, calc(100% - 40px));
        padding: clamp(10px, 1.2svh, 16px) clamp(12px, 2vw, 24px);
        transform: translate(-50%, -50%);
        z-index: 1;
      }

      .matrix {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-size: clamp(1.125rem, min(3.6vw, 2.7svh), 1.8rem);
        font-variant-numeric: lining-nums tabular-nums;
        font-family: "Matrix Serif", "Cambria Math", serif;
        line-height: 1;
        color: #f1eade;
      }

      .matrix td {
        padding: 0.26em 0;
        text-align: center;
      }

      .matrix-number {
        position: relative;
        display: inline-block;
        white-space: nowrap;
      }

      .matrix-baseline {
        display: inline-block;
        width: 0;
        height: 0;
      }

      .matrix-number-lit {
        background-image: var(--contour-light);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
      }

      .matrix-number-lit::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: var(--contour-glow);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        filter: var(--number-bloom);
        opacity: 0.6;
      }

      @media (max-height: 520px) {
        .matrix-frame {
          top: 31%;
          width: min(26rem, calc(100% - 40px));
          padding-block: 4px;
        }

        .matrix {
          font-size: clamp(0.75rem, 2.7svh, 1rem);
        }

        .matrix td {
          padding-block: 0.28em;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute;">
        <defs>
          <filter id="number-glow-bloom" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
            <feGaussianBlur stdDeviation="1.8" />
            <feComponentTransfer>
              <feFuncA type="linear" slope="4" />
            </feComponentTransfer>
          </filter>
        </defs>
      </svg>
      <canvas id="alignment" aria-hidden="true"></canvas>
      <div class="matrix-frame">
        <table class="matrix" aria-label="N" style="--number-bloom: url(#number-glow-bloom);">
          <tbody>
            {rows.map((row) => (
              <tr>
                {row.map((value) => (
                  <td><span class="matrix-number">{value}<i class="matrix-baseline" aria-hidden="true"></i></span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>

<script>
  import { createAlignment } from "../alignment";
  import { createNumberLight } from "../number-light";

  const page = document.querySelector<HTMLElement>("main")!;
  const canvas = document.querySelector<HTMLCanvasElement>("#alignment")!;
  const frame = document.querySelector<HTMLElement>(".matrix-frame")!;
  const matrix = document.querySelector<HTMLTableElement>(".matrix")!;
  let disposed = false;
  let alignment: ReturnType<typeof createAlignment> | undefined;
  let observer: ResizeObserver | undefined;

  async function startScene() {
    await document.fonts.load('400 16px "Matrix Serif"');
    if (disposed) return;

    alignment = createAlignment(canvas, frame);
    const lightNumbers = createNumberLight(matrix);
    const render = () => {
      if (disposed) return;
      lightNumbers();
      alignment!.render();
      page.classList.add("scene-ready");
    };

    render();
    observer = new ResizeObserver(render);
    observer.observe(page);
    observer.observe(matrix);
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) render();
    });
  }

  void startScene();
  window.addEventListener("pagehide", (event) => {
    if (event.persisted) return;
    disposed = true;
    observer?.disconnect();
    alignment?.dispose();
  });
</script>
