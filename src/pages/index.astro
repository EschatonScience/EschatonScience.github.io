---
const rows = [
  [-85020, -170430, 3315, -482820, -974805, 6240],
  [-352422, 58338, 63, 16128, 78813, -429912],
  [6240, -85020, -170430, 3315, -482820, -974805],
  [-92106, -122976, 98784, 124929, 417564, 438669],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Eschaton Science</title>
    <style>
      @font-face {
        font-family: "Matrix Serif";
        src: url("/fonts/KaTeX_Main-Regular.woff2") format("woff2");
        font-style: normal;
        font-weight: 400;
        font-display: swap;
      }

      :root {
        color-scheme: dark;
        background: #000;
        color: #fff;
        font-family: "Matrix Serif", "Cambria Math", serif;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        overflow: hidden;
      }

      main {
        visibility: hidden;
        position: relative;
        width: 100%;
        height: 100svh;
        isolation: isolate;
        overflow: hidden;
        background: #000;
      }

      main.scene-ready {
        visibility: visible;
      }

      #alignment {
        position: absolute;
        inset: 0;
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        z-index: 0;
      }

      .matrix-frame {
        position: absolute;
        top: 29%;
        left: 50%;
        width: min(29em, calc(100% - 24px));
        font-size: clamp(0.625rem, min(3.6vw, 2.7svh), 1.8rem);
        padding: clamp(10px, 1.2svh, 16px) clamp(4px, 1vw, 20px);
        transform: translate(-50%, -50%);
        z-index: 1;
      }

      .matrix-frame::before {
        content: "";
        position: absolute;
        inset: -6px -32px;
        z-index: -1;
        border-radius: 16px;
        background: #000;
        pointer-events: none;
      }

      .matrix {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        font-size: inherit;
        font-variant-numeric: lining-nums tabular-nums;
        font-family: "Matrix Serif", "Cambria Math", serif;
        line-height: 1;
        color: #f1eade;
      }

      .matrix td {
        padding: 0.26em 0;
        text-align: center;
      }

      .matrix-number {
        position: relative;
        display: inline-block;
        white-space: nowrap;
      }

      .matrix-baseline {
        display: inline-block;
        width: 0;
        height: 0;
      }

      .matrix-number-lit {
        background-image: var(--contour-light);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        background-clip: text;
        -webkit-background-clip: text;
        color: transparent;
        -webkit-text-fill-color: transparent;
      }

      .matrix-number-lit::before {
        content: "";
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
        background-image: var(--contour-glow);
        background-size: 100% 100%;
        background-repeat: no-repeat;
        filter: var(--number-bloom);
        opacity: 0.72;
      }

      @media (max-height: 520px) {
        .matrix-frame {
          top: 31%;
          padding-block: 4px;
          font-size: clamp(0.625rem, min(3.6vw, 2.7svh), 1rem);
        }

        .matrix td {
          padding-block: 0.28em;
        }
      }
    </style>
  </head>
  <body>
    <main>
      <svg width="0" height="0" aria-hidden="true" focusable="false" style="position: absolute;">
        <defs>
          <filter id="number-glow-bloom" x="-30%" y="-30%" width="160%" height="160%" color-interpolation-filters="sRGB">
            <feGaussianBlur stdDeviation="1.8" />
            <feComponentTransfer>
              <feFuncA type="linear" slope="4" />
            </feComponentTransfer>
          </filter>
        </defs>
      </svg>
      <img id="alignment" src="/scene.png" width="3840" height="2160" alt="" decoding="sync" fetchpriority="high" />
      <div class="matrix-frame">
        <table class="matrix" aria-label="M square" style="--number-bloom: url(#number-glow-bloom);">
          <tbody>
            {rows.map((row) => (
              <tr>
                {row.map((value) => (
                  <td><span class="matrix-number">{value}<i class="matrix-baseline" aria-hidden="true"></i></span></td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </main>
  </body>
</html>

<script>
  import { createNumberLight } from "../number-light";

  console.info(
    '"At the first blush it seems to us that the theories last only a day and that ruins upon ruins accumulate. Today the theories are born, tomorrow they are the fashion, the day after tomorrow they are classic, the fourth day they are superannuated, and the fifth they are forgotten. But if we look more closely, we see that what thus succumb are the theories, properly so called, those which pretend to teach us what things are. But there is in them something which usually survives. If one of them has taught us a true relation, this relation is definitively acquired, and it will be found again under a new disguise in the other theories which will successively come to reign in place of the old." — Henri Poincaré'
  );

  const page = document.querySelector<HTMLElement>("main")!;
  const background = document.querySelector<HTMLImageElement>("#alignment")!;
  const matrix = document.querySelector<HTMLTableElement>(".matrix")!;
  let disposed = false;
  let observer: ResizeObserver | undefined;

  async function startScene() {
    await Promise.all([
      document.fonts.load('400 16px "Matrix Serif"'),
      background.decode(),
    ]);
    if (disposed) return;

    const lightNumbers = createNumberLight(matrix);
    const render = () => {
      if (disposed) return;
      lightNumbers();
      page.classList.add("scene-ready");
    };

    render();
    observer = new ResizeObserver(render);
    observer.observe(matrix);
    window.addEventListener("pageshow", (event) => {
      if (event.persisted) render();
    });
  }

  void startScene();
  window.addEventListener("pagehide", (event) => {
    if (event.persisted) return;
    disposed = true;
    observer?.disconnect();
  });
</script>
